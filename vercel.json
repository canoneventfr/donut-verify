{
  "version": 2,
  "builds": [
    { "src": "send.js", "use": "@vercel/node" },
    { "src": "check.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/send", "dest": "/send.js" },
    { "src": "/api/check", "dest": "/check.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/donutsmp-store-gate.html" },
    { "src": "/login", "dest": "/donutsmp-store-gate.html" },
    { "src": "/checkout", "dest": "/donutsmp-checkout-flow.html" },
    { "src": "/claim", "dest": "/donutsmp-checkout-layout.html" },
    { "src": "/gift", "dest": "/donutsmp-checkout-layout.html" },
    { "src": "/payment", "dest": "/donutsmp-payment-step.html" }
  ]
}
