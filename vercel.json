{
  "buildCommand": "echo 'Static build'",
  "devCommand": "node server.js",
  "installCommand": "echo 'No install needed'",
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/donutsmp-payment-step.html" },
    { "source": "/claim", "destination": "/donutsmp-checkout-layout.html" },
    { "source": "/login", "destination": "/donutsmp-store-gate.html" },
    { "source": "/gift", "destination": "/donutsmp-checkout-layout.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
