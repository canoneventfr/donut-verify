{
  "version": 2,
  "buildCommand": "node build.cjs",
  "outputDirectory": "dist",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" },
    { "src": "send.js", "use": "@vercel/node" },
    { "src": "check.js", "use": "@vercel/node" },
    { "src": "visit.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/send", "dest": "/send.js" },
    { "src": "/api/check", "dest": "/check.js" },
    { "src": "/api/visit", "dest": "/visit.js" },
    { "handle": "filesystem" },

    { "src": "/claim/([^/]+)", "dest": "/donutsmp-store-gate.html" },

    { "src": "/checkout", "dest": "/donutsmp-checkout-layout.html" },
    { "src": "/basket", "dest": "/donutsmp-checkout-flow.html" },
    { "src": "/payment", "dest": "/donutsmp-payment-step.html" }
  ]
}
